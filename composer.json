{
    "name": "codebar-ag/llm-gateway",
    "type": "project",
    "description": "Async job queue facade in front of LiteLLM — gives Ollama-backed setups a real background queue with the OpenAI Responses API shape.",
    "keywords": [
        "laravel",
        "litellm",
        "ollama",
        "llm",
        "queue",
        "gateway"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "guzzlehttp/guzzle": "^7.10",
        "inertiajs/inertia-laravel": "^3.2",
        "laravel/framework": "^13.3",
        "laravel/tinker": "^3.0"
    },
    "require-dev": {
        "codebar-ag/coding-guidelines": "^1.2",
        "fakerphp/faker": "^1.24.1",
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.29",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^8.9.2",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php artisan migrate --graceful --ansi"
        ],
        "test": "./vendor/bin/pest --compact",
        "lint": "./vendor/bin/pint",
        "analyse": "./vendor/bin/phpstan analyse --memory-limit=1G",
        "verify": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "repositories": {
        "codebar-coding-guidelines": {
            "type": "vcs",
            "url": "https://github.com/codebar-ag/coding-guidelines"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
