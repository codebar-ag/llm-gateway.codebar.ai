meta {
  name: Create moderation
  type: http
  seq: 13
}

post {
  url: {{host}}/v1/moderations
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{key}}
  Content-Type: application/json
}

body:json {
  {
    "input": "Say PONG"
  }
}

vars:post-response {
  moderationId: res.body.id
}

docs {
  Queued and collected the same way **Create embedding** is. Answers `202`;
  read the verdict back with **Collect moderation**.

  Only OpenAI-compatible upstreams have ever implemented this endpoint. A
  gateway on Anthropic or Ollama forwards the request anyway and records
  that upstream's own `404`, rather than this app guessing at support it
  cannot verify.
}
