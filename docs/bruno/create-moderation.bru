meta {
  name: Create moderation
  type: http
  seq: 12
}

post {
  url: {{host}}/v1/moderations
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{key}}
  Content-Type: application/json
}

body:json {
  {
    "input": "Say PONG"
  }
}

docs {
  Synchronous and rate limited the same way **Create embedding** is. Only
  OpenAI-compatible upstreams have ever implemented this endpoint — on an
  Anthropic or Ollama gateway the request is still forwarded, and that
  upstream's own `404` comes back under `error.type: upstream_error` rather
  than this app guessing at support it cannot verify.
}
