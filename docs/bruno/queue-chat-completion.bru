meta {
  name: Queue chat completion
  type: http
  seq: 2
}

post {
  url: {{host}}/v1/chat/completions
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{key}}
  Content-Type: application/json
}

body:json {
  {
    "model": "{{model}}",
    "messages": [
      { "role": "user", "content": "Say PONG" }
    ]
  }
}

docs {
  Queued, not executed synchronously. Responds `202` with `id` and
  `poll_url` — the request is picked up by a worker and replayed to
  LiteLLM unchanged. Poll `GET /v1/responses/{id}` with the same
  `Authorization` to collect the answer.
}
