# Laravel Dusk with Laravel Herd
#
# Herd resolves `*.test` for you (custom local DNS). This template uses:
#   APP_URL=https://laravel-start.test
#
# 1. Copy this file to `.env.dusk.local` (gitignored), or duplicate your `.env` and align values below.
# 2. Keep `APP_URL` in sync with the Herd site you open in the browser (see APP_URL below).
# 3. Use a dedicated test database (`DB_DATABASE` below) so Dusk never touches your dev data; credentials/host can match Postgres.
# 4. Run browser tests: `php artisan dusk` (Dusk temporarily swaps `.env` with `.env.dusk.local` while tests run).
#
# Your main `.env` can use the same `APP_URL` for day-to-day Herd development.

APP_NAME="Laravel Start"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://laravel-start.test

NOVA_LICENSE_KEY=

LOG_CHANNEL=stack
LOG_STACK=single,nightwatch
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

NIGHTWATCH_ENABLED=false
NIGHTWATCH_TOKEN=

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=laravel_test
DB_USERNAME=root
DB_PASSWORD=

FPH_ENABLED=true
CSP_ENABLED=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=laravel-start.test

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

MAIL_MAILER=log
MAIL_HOST=localhost
MAIL_PORT=2525
MAIL_USERNAME="Template Laravel"
MAIL_PASSWORD=null

MAIL_FROM_ADDRESS="hello@codebar.ch"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

CLOUDINARY_CLOUD_NAME=my-cloud-name
CLOUDINARY_API_KEY=my-api-key
CLOUDINARY_API_SECRET=my-api-secret

MICROSOFT_ENTRA_SSO_TENANT_ID=your-tenant-id
MICROSOFT_ENTRA_SSO_CLIENT_ID=your-client-id
MICROSOFT_ENTRA_SSO_CLIENT_SECRET=your-client-secret
MICROSOFT_ENTRA_SSO_REDIRECT_URI="${APP_URL}/sso/microsoft/web/callback"
