APP_NAME="Laravel Start"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://laravel-start.test

# Browser (Dusk) with Herd (`https://laravel-start.test` + custom `*.test` DNS): see .env.dusk.example — copy to .env.dusk.local, then run: php artisan dusk
# When RUN_BROWSER_TESTS=1 (Pest Browser folder), set true so a failed chromedriver start skips tests instead of erroring (local only; keep false in CI).
# DUSK_SOFT_CHROMEDRIVER=false

# Trusted proxies: `*` (default) = trust X-Forwarded-* from the TCP peer Laravel sees (typical Herd/Valet/nginx). For production, set your load balancer IPs/CIDRs as a comma-separated list (see Laravel trusted proxies docs).
# TRUSTED_PROXIES=*

NOVA_LICENSE_KEY=

LOG_CHANNEL=stack
LOG_STACK=single,nightwatch
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Nightwatch is required for production-style deployments: set NIGHTWATCH_TOKEN, enable the agent
# (`php artisan nightwatch:agent`, supervised), and keep LOG_STACK including `nightwatch`.
NIGHTWATCH_ENABLED=false
NIGHTWATCH_TOKEN=

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
#DB_READ_HOST=127.0.0.1
#DB_WRITE_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=laravel-start
DB_USERNAME=root
DB_PASSWORD=

FPH_ENABLED=true
CSP_ENABLED=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Set true in production when you want session payloads encrypted at rest (see config/session.php).
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave empty for single-host local dev (e.g. Herd): host-only session cookies avoid OAuth callback losing the session.
# Set e.g. .yourdomain.com only when sharing sessions across subdomains.
SESSION_DOMAIN=
# When APP_URL uses https://, set true so the session cookie is sent on the Microsoft OAuth return redirect.
SESSION_SECURE_COOKIE=true

# Microsoft Entra SSO stores OAuth state in the session. APP_URL, the browser URL, and the Entra redirect URI must match (scheme + host + path).

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

MAIL_MAILER=log
MAIL_HOST=localhost
MAIL_PORT=2525
MAIL_USERNAME="Template Laravel"
MAIL_PASSWORD=null

MAIL_FROM_ADDRESS="hello@codebar.ch"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_BUCKET=
AWS_DEFAULT_REGION=fra1
AWS_ENDPOINT=https://fra1.digitaloceanspaces.com
AWS_CDN_ENDPOINT=https://srv-dev-space-fra-001.fra1.cdn.digitaloceanspaces.com
AWS_SECRET_ACCESS_KEY=


# Lasso: bundles use the `s3` disk (`AWS_*`). Set LASSO_ENV to match production (e.g. production).
# LASSO_ENV=production
# Optional: Laravel Cloud deploy webhook after successful `lasso:publish` (also set in GitHub Actions secrets).
# LARAVEL_CLOUD_DEPLOY_WEBHOOK_URL=

VITE_APP_NAME="${APP_NAME}"

# Analytics (see config/default.php — loaded only in configured environments, e.g. staging/production)
# FATHOM_SITE_ID=
# FATHOM_URL=https://cdn-eu.usefathom.com/script.js
# USERBACK_TOKEN=
# USERBACK_URL=https://static.userback.io/widget/v1.js

CLOUDINARY_CLOUD_NAME=my-cloud-name
CLOUDINARY_API_KEY=my-api-key
CLOUDINARY_API_SECRET=my-api-secret

MICROSOFT_ENTRA_SSO_TENANT_ID=your-tenant-id
MICROSOFT_ENTRA_SSO_CLIENT_ID=your-client-id
MICROSOFT_ENTRA_SSO_CLIENT_SECRET=your-client-secret
MICROSOFT_ENTRA_SSO_REDIRECT_URI="${APP_URL}/sso/microsoft/web/callback"

# Spatie Health + Oh Dear: set monitor URL to APP_URL + OH_DEAR_HEALTH_CHECK_PATH; Oh Dear sends header oh-dear-health-check-secret (see Spatie docs).
OH_DEAR_HEALTH_CHECK_ENABLED=false
OH_DEAR_HEALTH_CHECK_SECRET=
OH_DEAR_HEALTH_CHECK_PATH=/oh-dear-health-check-results
