APP_NAME="LLM Gateway"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://llm.async.example.com

# Rotating daily files; LOG_DAILY_DAYS is how many are kept.
LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=30

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=llm_gateway
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=database

# Keep this true wherever APP_URL is https. The dashboard token is remembered
# in a cookie, and without it a browser will replay that cookie over plain HTTP.
SESSION_SECURE_COOKIE=true

# Which proxies may set X-Forwarded-For. Herd, Caddy, nginx and cloudflared all
# run on this host, so loopback is the default. Behind a load balancer on
# another host, set its IPs or CIDRs (comma separated).
#
# Do not use `*` on a reachable deployment: it trusts any client's
# X-Forwarded-For, and BACKLOG_RATE_LIMIT buckets keyless callers by IP, so a
# spoofed header hands out a fresh bucket per request and lifts the limit.
TRUSTED_PROXIES=127.0.0.1,::1

# ── Upstream ────────────────────────────────────────────────────────
# No key here: the gateway holds no credentials. Every caller sends their
# own key, which is stored encrypted and replayed upstream.
#
# Upstreams themselves live in the `gateways` table and are managed at
# /gateways in the dashboard. This URL only seeds the first one on a fresh
# migrate; after that, edit the gateway, not the .env.
GATEWAY_SEED_URL=http://127.0.0.1:4000
# Ceiling for any single gateway's timeout, in seconds. It must exceed the
# slowest model response, and the queue's retry_after is derived from it.
GATEWAY_MAX_TIMEOUT=900
GATEWAY_CONNECT_TIMEOUT=10

# ── Backlog ─────────────────────────────────────────────────────────
BACKLOG_QUEUE=default
# Keep in sync with OLLAMA_NUM_PARALLEL and the number of running workers.
BACKLOG_WORKERS=2
BACKLOG_MAX_ATTEMPTS=2
BACKLOG_RETRY_DELAY=3
# Days a finished entry keeps its request/response bodies before backlog:prune
# empties them (the row, its usage and its error stay). 0 = keep forever.
BACKLOG_PRUNE_DAYS=7
# Queue requests per minute, per caller key (per IP without one). 0 = no limit.
BACKLOG_RATE_LIMIT=60
# How the queue wait reported to callers is estimated: how many recent entries
# per model are measured, what to assume before that many exist, and how long
# the measurement is cached.
BACKLOG_ESTIMATE_SAMPLE=20
BACKLOG_ESTIMATE_DEFAULT_SECONDS=30
BACKLOG_ESTIMATE_TTL=5

# ── API ─────────────────────────────────────────────────────────────
# Entries belong to the key that queued them. Callers sending no key all share
# one bucket and can read, cancel and delete each other's entries — set this to
# true on anything reachable so every entry has an owner. It checks only that a
# key was sent; whether it is any good stays the upstream's decision.
API_REQUIRE_CALLER_KEY=false

# How long a /v1/models listing is reused, in seconds. These reads are not rate
# limited and need no key by default, so without this every public request is
# one more request the upstream answers. Cached per gateway and per caller key —
# an upstream serves a different model list per key — and only on success.
# 0 = always ask the upstream.
API_MODELS_CACHE_TTL=30

# ── Dashboard ───────────────────────────────────────────────────────
# The dashboard at / renders whole prompts and answers, so it is guarded by
# this one shared operator token — not by a caller's LiteLLM key. Open
# https://your-host/?token=… once and it is remembered in a cookie.
#
#   openssl rand -hex 32
#
# This is the *outer* of two guards and it is optional. A dashboard login is
# always required regardless — see `php artisan user:register`. Leave this empty
# and the login alone guards the dashboard; set it and a visitor must present
# the token before they even reach the login form. The /v1 API is unaffected
# either way.
DASHBOARD_TOKEN=

# ── Tunnel ──────────────────────────────────────────────────────────
# cloudflared's metrics address; the dashboard reads /ready from it to
# show the tunnel indicator. Leave empty to disable the indicator.
TUNNEL_METRICS_URL=
TUNNEL_TIMEOUT=2
